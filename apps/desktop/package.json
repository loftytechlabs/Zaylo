{
  "name": "@local-ai/desktop",
  "version": "1.0.0",
  "description": "Zaylo High-Performance Local AI Server Desktop App",
  "author": "Lofty Tech Labs <contact@loftytechlabs.com>",
  "homepage": "https://github.com/loftytechlabs/Zaylo",
  "license": "MIT",
  "repository": "https://github.com/loftytechlabs/Zaylo",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.zaylo.ai",
    "productName": "Zaylo",
    "executableName": "zaylo",
    "publish": {
      "provider": "github",
      "owner": "loftytechlabs",
      "repo": "Zaylo"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "executableName": "zaylo"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "executableName": "zaylo",
      "maintainer": "Lofty Tech Labs <contact@loftytechlabs.com>",
      "synopsis": "Zaylo High-Performance Local AI Inference Server",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@local-ai/capabilities": "workspace:*",
    "@local-ai/database": "workspace:*",
    "@local-ai/hardware": "workspace:*",
    "@local-ai/inference": "workspace:*",
    "@local-ai/models": "workspace:*",
    "@local-ai/monitoring": "workspace:*",
    "@local-ai/network": "workspace:*",
    "@local-ai/protocol": "workspace:*",
    "@local-ai/runtime-llama": "workspace:*",
    "@local-ai/runtimes": "workspace:*",
    "@local-ai/security": "workspace:*",
    "@local-ai/server": "workspace:*",
    "@local-ai/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
